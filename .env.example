# ==============================================================
# HabitSync AI - Phase 1 Environment Configuration
# ==============================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Twilio Credentials (Get free sandbox from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

TWILIO_CONTENT_SID=HXfe5ab5f00277942d4d4200328b4d403c

# Your WhatsApp Number with Country Code (e.g., whatsapp:+919876543210)
USER_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# Active Notification Channel ("telegram", "whatsapp", or "both")
NOTIFICATION_CHANNEL=both

# Telegram Bot Credentials (Get free bot from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Tasks OAuth (Use files locally; paste JSON contents as env vars in Cloud)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_TOKEN_JSON=

# Cloud & 24/7 Automated Scheduler Settings
# PUBLIC_BASE_URL=https://your-app.onrender.com
# DASHBOARD_PASSWORD=choose_a_strong_password_for_cloud
REMINDER_ENABLED=false
REMINDER_INTERVAL_MINUTES=240
REMINDER_TIMEZONE=Asia/Kolkata
REMINDER_START_HOUR=8
REMINDER_END_HOUR=22

# Local Server Settings
PORT=8000
HOST=0.0.0.0
